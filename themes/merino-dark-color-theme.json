  "tokenColors": [
    // ===== Merino base tokens (from source.foreground) =====
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#6e7681"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#a5d6ff"
      }
    },
    {
      "name": "Constant",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character.escape",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#79c0ff"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.other.special-method",
        "storage.type.class",
        "storage.type.function",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ff7b72"
      }
    },
    {
      "name": "Storage types & modifiers",
      "scope": [
        "storage.type.ts",
        "storage.type.js",
        "storage.modifier.ts",
        "storage.modifier.async"
      ],
      "settings": {
        "foreground": "#ff7b72"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#ff7b72"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#d2a8ff"
      }
    },
    {
      "name": "Type / Class",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.name.namespace",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#ffa657"
      }
    },
    {
      "name": "Variable / Property",
      "scope": [
        "variable",
        "variable.other.property",
        "variable.other.member",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#e6edf3"
      }
    },
    {
      "name": "Parameter / Argument",
      "scope": [
        "variable.parameter",
        "meta.parameter.type-variable"
      ],
      "settings": {
        "foreground": "#ffa657"
      }
    },
    {
      "name": "Regex / Escape",
      "scope": [
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#7ee787"
      }
    },
    {
      "name": "Tag delimiters",
      "scope": [
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#8b949e"
      }
    },
    {
      "name": "Markup heading",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#79c0ff"
      }
    },
    {
      "name": "Markup bold / italic",
      "scope": [
        "markup.bold",
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup link / underline",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#58a6ff"
      }
    },
    {
      "name": "Markup inserted",
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#3fb950"
      }
    },
    {
      "name": "Markup deleted",
      "scope": "markup.deleted",
      "settings": {
        "foreground": "#f85149"
      }
    }
  ]
}
